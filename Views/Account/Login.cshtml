@{
    ViewData["Title"] = "Login";
}

<div class="kc-auth-page">

    <div class="kc-auth-side">

        <div class="kc-logo-large">
            K
        </div>

        <span class="kc-eyebrow">
            Welcome back
        </span>

        <h1>
            Your business keeps moving.
            KasiCash keeps the record.
        </h1>

        <p>
            Sign in to continue recording
            sales, managing stock and
            tracking customer credit.
        </p>

    </div>

    <div class="kc-form-card">

        <h2>
            Sign in
        </h2>

        <p>
            Access your KasiCash business account.
        </p>


        @if (TempData["Success"] != null)
        {
            <div class="kc-alert-success">
                @TempData["Success"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="kc-alert-error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div class="kc-field">

                <label>
                    Email Address
                </label>

                <input type="email"
                       name="email"
                       required
                       placeholder="you@example.com" />

            </div>

            <div class="kc-field">

                <label>
                    Password
                </label>

                <input type="password"
                       name="password"
                       required
                       placeholder="Enter password" />

            </div>

            <button type="submit"
                    class="kc-primary-button w-100">

                Sign In

            </button>

        </form>

        <div class="kc-auth-bottom">

            Don't have an account?

            <a asp-controller="Account"
               asp-action="Register">
                Create one
            </a>

        </div>

    </div>

</div>