@{
    ViewData["Title"] = "Create Account";
}

<section class="kc-register-page">

    <div class="kc-register-shell">


        <!-- ==================================================
             LEFT SIDE — ONBOARDING STORY
             ================================================== -->

        <div class="kc-register-side">

            <div class="kc-register-side-inner">

                <span class="kc-eyebrow">
                    Start your digital journey
                </span>

                <h1>
                    Turn your business
                    activity into a
                    financial story.
                </h1>

                <p>
                    Create your KasiCash business profile
                    and start recording sales, inventory
                    and customer credit in one place.
                </p>


                <div class="kc-register-benefits">


                    <div class="kc-register-benefit">

                        <span class="kc-register-benefit-icon">
                            🛒
                        </span>

                        <div>

                            <strong>
                                Record everyday sales
                            </strong>

                            <small>
                                Capture cash and credit
                                transactions digitally.
                            </small>

                        </div>

                    </div>


                    <div class="kc-register-benefit">

                        <span class="kc-register-benefit-icon">
                            📦
                        </span>

                        <div>

                            <strong>
                                Track your stock
                            </strong>

                            <small>
                                Know what is available
                                and what needs restocking.
                            </small>

                        </div>

                    </div>


                    <div class="kc-register-benefit">

                        <span class="kc-register-benefit-icon">
                            📈
                        </span>

                        <div>

                            <strong>
                                Build digital history
                            </strong>

                            <small>
                                Every recorded activity
                                strengthens your business record.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="kc-register-visual-card">

                    <div class="kc-register-visual-top">

                        <span>
                            Business Profile
                        </span>

                        <span class="kc-register-active-badge">
                            READY
                        </span>

                    </div>


                    <div class="kc-register-visual-main">

                        <div class="kc-register-profile-icon">
                            K
                        </div>

                        <div>

                            <strong>
                                Your KasiCash Business
                            </strong>

                            <span>
                                Digital profile setup
                            </span>

                        </div>

                    </div>


                    <div class="kc-register-progress">

                        <div>
                            <span>
                                Profile
                            </span>

                            <strong>
                                Step 1
                            </strong>
                        </div>

                        <div>
                            <span>
                                Next
                            </span>

                            <strong>
                                Add Stock
                            </strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==================================================
             RIGHT SIDE — REGISTRATION FORM
             ================================================== -->

        <div class="kc-register-form-wrap">

            <div class="kc-register-form-card">

                <div class="kc-register-form-header">

                    <span class="kc-register-step">
                        Business setup
                    </span>

                    <h2>
                        Create your KasiCash account
                    </h2>

                    <p>
                        Tell us about you and your business
                        to create your secure digital profile.
                    </p>

                </div>


                <form method="post"
                      class="kc-register-form">

                    @Html.AntiForgeryToken()


                    @if (ViewBag.Error != null)
                    {
                        <div class="kc-alert-error">

                            @ViewBag.Error

                        </div>
                    }


                    <!-- Personal details -->

                    <div class="kc-register-section">

                        <div class="kc-register-section-title">

                            <span>
                                01
                            </span>

                            <div>

                                <strong>
                                    Personal details
                                </strong>

                                <small>
                                    Information about the account owner
                                </small>

                            </div>

                        </div>


                        <div class="kc-field">

                            <label for="FullName">
                                Full Name
                            </label>

                            <input id="FullName"
                                   type="text"
                                   name="FullName"
                                   placeholder="e.g. Thandi Mokoena"
                                   autocomplete="name"
                                   required />

                        </div>


                        <div class="kc-field">

                            <label for="PhoneNumber">
                                Phone Number
                            </label>

                            <input id="PhoneNumber"
                                   type="tel"
                                   name="PhoneNumber"
                                   placeholder="e.g. 071 234 5678"
                                   autocomplete="tel"
                                   required />

                        </div>


                        <div class="kc-field">

                            <label for="Email">
                                Email Address
                            </label>

                            <input id="Email"
                                   type="email"
                                   name="Email"
                                   placeholder="e.g. thandi@email.com"
                                   autocomplete="email"
                                   required />

                        </div>

                    </div>


                    <!-- Business details -->

                    <div class="kc-register-section">

                        <div class="kc-register-section-title">

                            <span>
                                02
                            </span>

                            <div>

                                <strong>
                                    Business details
                                </strong>

                                <small>
                                    Tell KasiCash about your business
                                </small>

                            </div>

                        </div>


                        <div class="kc-field">

                            <label for="BusinessName">
                                Business Name
                            </label>

                            <input id="BusinessName"
                                   type="text"
                                   name="BusinessName"
                                   placeholder="e.g. Mama Thandi's Kota Spot"
                                   required />

                        </div>


                        <div class="kc-field">

                            <label for="BusinessType">
                                Business Type
                            </label>

                            <select id="BusinessType"
                                    name="BusinessType"
                                    required>

                                <option value="">
                                    Select business type
                                </option>

                                <option>
                                    Spaza Shop
                                </option>

                                <option>
                                    Street Vendor
                                </option>

                                <option>
                                    Food Business
                                </option>

                                <option>
                                    Salon / Barber
                                </option>

                                <option>
                                    Clothing Business
                                </option>

                                <option>
                                    Mechanic
                                </option>

                                <option>
                                    Other
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- Security -->

                    <div class="kc-register-section">

                        <div class="kc-register-section-title">

                            <span>
                                03
                            </span>

                            <div>

                                <strong>
                                    Secure your account
                                </strong>

                                <small>
                                    Protect your business information
                                </small>

                            </div>

                        </div>


                        <div class="kc-two-fields">

                            <div class="kc-field">

                                <label for="Password">
                                    Password
                                </label>

                                <input id="Password"
                                       type="password"
                                       name="Password"
                                       placeholder="Create password"
                                       autocomplete="new-password"
                                       required />

                            </div>


                            <div class="kc-field">

                                <label for="ConfirmPassword">
                                    Confirm Password
                                </label>

                                <input id="ConfirmPassword"
                                       type="password"
                                       name="ConfirmPassword"
                                       placeholder="Repeat password"
                                       autocomplete="new-password"
                                       required />

                            </div>

                        </div>


                        <div class="kc-password-requirements">

                            <span>
                                🔒
                            </span>

                            <p>
                                Use at least 8 characters with
                                uppercase, lowercase, a number
                                and a special character.
                            </p>

                        </div>

                    </div>


                    <button type="submit"
                            class="kc-register-submit">

                        <span>
                            Create My KasiCash Account
                        </span>

                        <span>
                            →
                        </span>

                    </button>


                    <div class="kc-register-security-note">

                        <span>
                            🛡️
                        </span>

                        <p>
                            Your account is protected using
                            secure authentication and your
                            business records remain linked
                            to your profile.
                        </p>

                    </div>

                </form>


                <div class="kc-register-login">

                    <span>
                        Already have a KasiCash account?
                    </span>

                    <a asp-controller="Account"
                       asp-action="Login">

                        Sign in here

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>