@{
    ViewData["Title"] = "KasiCash";
}

<section class="hero">
    <div class="hero-content">
        <h1>KasiCash</h1>
        <h2>Turn everyday cash into a financial identity.</h2>

        <p>
            KasiCash helps kasi entrepreneurs record sales, track expenses,
            understand profits and build a financial history that can unlock
            future access to credit, insurance and other financial services.
        </p>

        <div class="hero-buttons">
            <a asp-controller="Account" asp-action="Register" class="btn-primary">
                Get Started
            </a>
            <a href="#" class="btn-secondary">Login</a>
        </div>
    </div>
</section>

<section class="features" id="features">
    <h2>Run your kasi business smarter</h2>

    <div class="feature-grid">

        <div class="feature-card">
            <h3>💰 Record Sales</h3>
            <p>Quickly capture your daily cash and digital sales.</p>
        </div>

        <div class="feature-card">
            <h3>🧾 Track Expenses</h3>
            <p>Record stock, transport, rent and other business costs.</p>
        </div>

        <div class="feature-card">
            <h3>📊 Know Your Profit</h3>
            <p>See how much your business earns after expenses.</p>
        </div>

        <div class="feature-card">
            <h3>🪪 Build Your Financial Identity</h3>
            <p>
                Your business activity creates a digital financial history
                that grows with your business.
            </p>
        </div>

    </div>
</section>

<section class="how-it-works" id="how-it-works">
    <h2>How KasiCash Works</h2>

    <div class="steps">
        <div>
            <span>1</span>
            <h3>Record</h3>
            <p>Add your daily sales and expenses.</p>
        </div>

        <div>
            <span>2</span>
            <h3>Grow</h3>
            <p>Build a trusted record of your business activity.</p>
        </div>

        <div>
            <span>3</span>
            <h3>Unlock</h3>
            <p>Move towards credit, insurance and other financial opportunities.</p>
        </div>
    </div>
</section>