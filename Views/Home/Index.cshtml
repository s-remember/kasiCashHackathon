@{
    ViewData["Title"] = "Home";
}

<section class="kc-hero">

    <div class="kc-hero-copy">

        <div class="kc-eyebrow">
            Built for kasi entrepreneurs
        </div>

        <h1>
            Your till.
            Your stock.
            Your financial story.
        </h1>

        <p>
            KasiCash helps informal and micro-businesses
            record everyday sales, manage stock,
            track customer credit and build a trusted
            digital record of business activity.
        </p>

        <div class="kc-hero-actions">

            <a asp-controller="Account"
               asp-action="Register"
               class="kc-primary-button">
                Start with KasiCash
            </a>

            <a asp-controller="Account"
               asp-action="Login"
               class="kc-secondary-button">
                Sign in
            </a>

        </div>

        <div class="kc-trust-row">

            <span>✓ Simple sales</span>
            <span>✓ Stock alerts</span>
            <span>✓ Credit tracking</span>

        </div>

    </div>

    <div class="kc-hero-card">

        <div class="kc-preview-top">

            <span>
                Today's business
            </span>

            <span class="kc-live">
                ● LIVE
            </span>

        </div>

        <div class="kc-preview-amount">
            R 2,480.00
        </div>

        <div class="kc-preview-label">
            Recorded sales
        </div>

        <div class="kc-preview-grid">

            <div>
                <strong>18</strong>
                <span>Sales</span>
            </div>

            <div>
                <strong>4</strong>
                <span>Credit</span>
            </div>

            <div>
                <strong>3</strong>
                <span>Low stock</span>
            </div>

        </div>

    </div>

</section>

<section id="features"
         class="kc-section">

    <div class="kc-section-heading">

        <span class="kc-eyebrow">
            One place. Less admin.
        </span>

        <h2>
            Everything the shop owner needs
            during a busy day.
        </h2>

    </div>

    <div class="kc-feature-grid">

        <article class="kc-feature-card">

            <div class="kc-feature-icon">
                🛒
            </div>

            <h3>
                Fast POS Sales
            </h3>

            <p>
                Select a product, quantity and payment
                type. KasiCash calculates the total
                automatically.
            </p>

        </article>

        <article class="kc-feature-card">

            <div class="kc-feature-icon">
                📦
            </div>

            <h3>
                Smart Stock
            </h3>

            <p>
                Stock decreases automatically after each
                sale and low-stock items are highlighted.
            </p>

        </article>

        <article class="kc-feature-card">

            <div class="kc-feature-icon">
                🤝
            </div>

            <h3>
                Customer Credit
            </h3>

            <p>
                Know who owes your business, how much
                they owe and when payment is due.
            </p>

        </article>

        <article class="kc-feature-card">

            <div class="kc-feature-icon">
                📈
            </div>

            <h3>
                Financial Footprint
            </h3>

            <p>
                Every recorded transaction contributes
                to a growing digital history of the
                business.
            </p>

        </article>

    </div>

</section>

<section id="how-it-works"
         class="kc-section kc-soft-section">

    <div class="kc-section-heading">

        <span class="kc-eyebrow">
            How it works
        </span>

        <h2>
            From a cash transaction
            to usable business history.
        </h2>

    </div>

    <div class="kc-steps">

        <div>
            <span>1</span>
            <h3>Record</h3>
            <p>
                Capture cash and credit sales.
            </p>
        </div>

        <div>
            <span>2</span>
            <h3>Manage</h3>
            <p>
                Monitor stock and customer debt.
            </p>
        </div>

        <div>
            <span>3</span>
            <h3>Understand</h3>
            <p>
                See real business activity
                on your dashboard.
            </p>
        </div>

        <div>
            <span>4</span>
            <h3>Grow</h3>
            <p>
                Build a stronger digital
                financial footprint.
            </p>
        </div>

    </div>

</section>