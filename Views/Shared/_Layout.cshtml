<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width,
                   initial-scale=1.0" />

    <title>
        @ViewData["Title"] - KasiCash
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

<header class="kc-nav">

    <div class="kc-nav-inner">

        <a class="kc-brand"
           asp-controller="Home"
           asp-action="Index">

            <span class="kc-logo">K</span>

            <span>
                KasiCash
            </span>

        </a>

        <nav class="kc-links">

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Dashboard"
               asp-action="Index">
                Dashboard
            </a>

            <a asp-controller="Sales"
               asp-action="Create">
                Process Sale
            </a>

            <a asp-controller="Products"
               asp-action="Index">
                Stock
            </a>

            <a asp-controller="CreditSales"
               asp-action="Index">
                Credit
            </a>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="kc-outline-button">
                    Logout
                </button>

            </form>
        }
        else
        {
            <a asp-controller="Home"
               asp-action="Index">
                Home
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="features">
                Features
            </a>

            <a asp-controller="Account"
               asp-action="Login">
                Login
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="kc-nav-cta">
                Get Started
            </a>
        }

        </nav>

    </div>

</header>

<main class="kc-main">
    @RenderBody()
</main>

<footer class="kc-footer">

    <div>
        <strong>KasiCash</strong>
        <span>
            Your business. Your records.
            Your financial future.
        </span>
    </div>

    <span>
        © 2026 KasiCash
    </span>

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>

@await RenderSectionAsync(
    "Scripts",
    required: false)

</body>
</html>