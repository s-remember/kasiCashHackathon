@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>KasiCash Dashboard</h2>
        <p class="text-muted">Manage your sales, credit and stock in one place.</p>
    </div>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm p-3">
                <h5>Today's Sales</h5>
                <h2>R0.00</h2>
                <p class="text-muted">Total cash sales recorded today</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm p-3">
                <h5>Money Owed</h5>
                <h2>R0.00</h2>
                <p class="text-muted">Outstanding customer credit</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm p-3">
                <h5>Stock Items</h5>
                <h2>0</h2>
                <p class="text-muted">Products currently recorded</p>
            </div>
        </div>

    </div>

    <hr />

    <h4 class="mb-3">Quick Actions</h4>

    <div class="row">

        <div class="col-md-3 mb-3">
            <a href="#" class="btn btn-success w-100 p-3">
                Record Cash Sale
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a href="#" class="btn btn-warning w-100 p-3">
                Record Credit Sale
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a href="#" class="btn btn-primary w-100 p-3">
                View Stock
            </a>
        </div>

        <div class="col-md-3 mb-3">
            <a href="#" class="btn btn-secondary w-100 p-3">
                View Customers
            </a>
        </div>

    </div>

</div>